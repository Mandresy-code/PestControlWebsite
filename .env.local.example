# Supabase — copie ce fichier en .env.local et remplis les valeurs
# Tu les trouves dans : Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Resend — envoi des emails de demande (diagnostic + contact)
# Crée un compte sur https://resend.com, récupère une clé API (Dashboard → API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Adresse d'expédition. Sans domaine vérifié sur Resend, garde onboarding@resend.dev.
# Une fois eseis.fr vérifié dans Resend, passe à un expéditeur du type demandes@eseis.fr.
EMAIL_FROM="ESEIS Pest Control <onboarding@resend.dev>"
# Destinataires des demandes (diagnostic + contact), séparés par des virgules
REQUEST_NOTIFICATION_EMAILS=cockpitgrdf@eseis.fr,mandresy.rasolonjatovo@eseis.fr
